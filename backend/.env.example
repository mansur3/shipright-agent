# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# 64 hex characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MODEL=
# Users are created only from these (12+ characters). Without them the app starts with no users.
SANKALP_ADMIN_PASSWORD=
# Optional demo accounts (cfo, supply, claims, rsm_north, cnf_east) sharing one password:
# SANKALP_DEMO_USERS=1
# SANKALP_DEMO_PASSWORD=
# Frontend origins allowed to call the API (comma separated)
SANKALP_ALLOWED_ORIGINS=http://localhost:3000

# LangSmith tracing (LangGraph/LangChain calls are traced automatically when these are set)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=ask-ai
LANGSMITH_AGENT_ENVIRONMENT=local
