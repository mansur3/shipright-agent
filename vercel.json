{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "250mb", "includeFiles": "backend/**", "excludeFiles": "backend/public/**" }
    },
    { "src": "backend/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/_next/(.*)", "dest": "/backend/public/_next/$1" },
    { "src": "/(.*\\.(?:svg|md|txt|ico|js|css|png|json|html|map|woff2?))$", "dest": "/backend/public/$1" },
    { "src": "/?$", "dest": "/backend/public/index.html" },
    { "src": "/(.*?)/?$", "dest": "/backend/public/$1/index.html" }
  ]
}