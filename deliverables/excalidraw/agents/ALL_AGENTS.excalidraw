   "link": null,
   "locked": false,
   "text": "Code only (no model)   |   file: backend/agent/analysis.py   |   page: /supply-check   |   used by: Kavita Rao and Vaishali Kapoor, monthly",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Code only (no model)   |   file: backend/agent/analysis.py   |   page: /supply-check   |   used by: Kavita Rao and Vaishali Kapoor, monthly",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "supply-t38",
   "type": "text",
   "x": 50,
   "y": 8224.375,
   "width": 1515.8000000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 847217401,
   "version": 1,
   "versionNonce": 611030145,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: The business is short and long at once: Lucknow holds 2% of stock for 19% of outward volume while Kolkata holds 29% for 15%, and Hooghly ships newer batches first. The allocation split is still\nthe FY25 one.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: The business is short and long at once: Lucknow holds 2% of stock for 19% of outward volume while Kolkata holds 29% for 15%, and Hooghly ships newer batches first. The allocation split is still\nthe FY25 one.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "supply-t39",
   "type": "text",
   "x": 50,
   "y": 8260.875,
   "width": 1337.0500000000002,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1774587164,
   "version": 1,
   "versionNonce": 856924418,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: INR 10.18 cr shortfall at six month-ends, 58% fillable from other C&Fs (each spare pack counted once); FEFO breaches on 54% to 64% of Hooghly lines against 0% at the other five.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Evidence: INR 10.18 cr shortfall at six month-ends, 58% fillable from other C&Fs (each spare pack counted once); FEFO breaches on 54% to 64% of Hooghly lines against 0% at the other five.",
   "autoResize": true,
   "lineHeight": 1.25
  },
