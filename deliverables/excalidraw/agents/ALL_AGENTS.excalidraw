   "seed": 589504031,
   "version": 1,
   "versionNonce": 2008910112,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: Claims are credited with no history check: the same stockist, batch and quantity is credited twice, claims arrive late, and quantities exceed what was ever supplied. Finance verifies the\npaperwork, not the history.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: Claims are credited with no history check: the same stockist, batch and quantity is credited twice, claims arrive late, and quantities exceed what was ever supplied. Finance verifies the\npaperwork, not the history.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "gatekeeper-t61",
