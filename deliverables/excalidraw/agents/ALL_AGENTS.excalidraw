  },
  {
   "id": "ask-t43",
   "type": "text",
   "x": 50,
   "y": 6793.8,
   "width": 1515.8000000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 220592469,
   "version": 1,
   "versionNonce": 1341584070,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: Leaders want a sourced number in seconds, and the loudest belief wins. The CFO believes a forecasting tool is the fix, but the data shows the shortage is an allocation split and the returns are\nscheme-pushed.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: Leaders want a sourced number in seconds, and the loudest belief wins. The CFO believes a forecasting tool is the fix, but the data shows the shortage is an allocation split and the returns are\nscheme-pushed.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ask-t44",
   "type": "text",
   "x": 50,
   "y": 6830.3,
   "width": 1272.7,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1534083808,
   "version": 1,
   "versionNonce": 1778460176,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: 58% of the INR 10.18 cr measured shortfall can be met from stock at other C&Fs (each spare pack counted once); scheme packs are claimed at 13% against 2.35% for others.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Evidence: 58% of the INR 10.18 cr measured shortfall can be met from stock at other C&Fs (each spare pack counted once); scheme packs are claimed at 13% against 2.35% for others.",
   "autoResize": true,
   "lineHeight": 1.25
  },
