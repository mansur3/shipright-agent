   "text": "Model + 11 tools (LangGraph)   |   file: backend/agent/graph.py   |   page: /ask   |   used by: Rohan Mehta, Kavita Rao, Neha Bansal, on demand",
   "fontSize": 14,
   "fontFamily": 2,
