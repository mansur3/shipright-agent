   "locked": false,
   "text": "Code + model (LangGraph)   |   file: backend/agent/claims_graph.py   |   page: /my-claims   |   used by: C&F agent or stockist, per claim; Auditor reviews",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Code + model (LangGraph)   |   file: backend/agent/claims_graph.py   |   page: /my-claims   |   used by: C&F agent or stockist, per claim; Auditor reviews",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "intake-t79",
   "type": "text",
   "x": 50,
   "y": 4802.0,
   "width": 1451.45,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1600796122,
   "version": 1,
   "versionNonce": 1917047933,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: Stockists and C&F agents file claims in many shapes: missing batch, no invoice, wrong quantity. Each gap costs days, and a late claim is resubmitted, so the same claim is logged twice.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: Stockists and C&F agents file claims in many shapes: missing batch, no invoice, wrong quantity. Each gap costs days, and a late claim is resubmitted, so the same claim is logged twice.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "intake-t80",
   "type": "text",
   "x": 50,
   "y": 4822.25,
   "width": 664.95,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 829041171,
   "version": 1,
   "versionNonce": 1388602396,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: Credit notes take 45 days on average against a 30-day policy; 76% are over 30 days.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Evidence: Credit notes take 45 days on average against a 30-day policy; 76% are over 30 days.",
   "autoResize": true,
   "lineHeight": 1.25
  },
