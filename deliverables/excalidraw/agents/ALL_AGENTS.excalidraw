   "versionNonce": 404265717,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: INR 51.5 L credited against clear policy rules in 30 months; 61 exact repeats worth INR 11.1 L; 69 pending claims fail a rule today (INR 21.0 L).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
