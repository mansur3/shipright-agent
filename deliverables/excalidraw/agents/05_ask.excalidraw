  {
   "id": "ask-t43",
   "type": "text",
   "x": 50,
   "y": 100,
   "width": 1515.8000000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
