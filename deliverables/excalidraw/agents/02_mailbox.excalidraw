   "link": null,
   "locked": false,
   "text": "A batch written with the letter O is a\nsuggestion, never a guess. Boxes\ninstead of strips, or a side-note in\nthe quantity, goes to a person.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A batch written with the letter O is a\nsuggestion, never a guess. Boxes\ninstead of strips, or a side-note in\nthe quantity, goes to a person.",
   "autoResize": true,
   "lineHeight": 1.25
  },
