   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: 4,503 claims replayed against the claims before them: 2,081 approve, 575 reject, 1,847 to a person. INR 85.4 L cannot be checked (batches older than the extracts).",
