   "versionNonce": 253207297,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: Nobody has a list of which already-credited claims broke a rule, how much, and from which stockist. Without it, no money can be claimed back.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: Nobody has a list of which already-credited claims broke a rule, how much, and from which stockist. Without it, no money can be claimed back.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
