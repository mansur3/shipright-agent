   "locked": false,
   "text": "Code only (no model)   |   file: backend/agent/analysis.py   |   page: /ask   |   used by: RSM before booking an order; Arjun Sethi (NSM) approves",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Code only (no model)   |   file: backend/agent/analysis.py   |   page: /ask   |   used by: RSM before booking an order; Arjun Sethi (NSM) approves",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "scheme-t55",
   "type": "text",
   "x": 50,
   "y": 100,
   "width": 1501.5000000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#475569",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 444688429,
   "version": 1,
   "versionNonce": 2068124765,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Problem it solves: Quarter-end scheme orders are accepted without checking how much stock the stockist already holds. There are no secondary sales, so closing stock cannot be measured and the RSM confirms it by\nconversation (policy 4.5).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Problem it solves: Quarter-end scheme orders are accepted without checking how much stock the stockist already holds. There are no secondary sales, so closing stock cannot be measured and the RSM confirms it by\nconversation (policy 4.5).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "scheme-t56",
   "type": "text",
   "x": 50,
   "y": 136.5,
   "width": 1151.15,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1719888007,
   "version": 1,
   "versionNonce": 267352361,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763800000000,
   "link": null,
   "locked": false,
   "text": "Evidence: 8% of scheme order lines add more than 2.5 months of normal purchase (ledger H15); scheme packs are claimed at 13% against 2.35% for other packs (H13).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Evidence: 8% of scheme order lines add more than 2.5 months of normal purchase (ledger H15); scheme packs are claimed at 13% against 2.35% for other packs (H13).",
   "autoResize": true,
   "lineHeight": 1.25
  },
